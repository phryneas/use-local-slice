{
  "name": "use-local-slice",
  "description": "A react hook to use reducers for local state in a typesafe way, with an API like createSlice from redux-starter-kit and immer integration.",
  "version": "1.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phryneas/use-local-slice.git"
  },
  "author": "phryneas",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "immer": "^10.0.0 || ^11.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "pkg-pr-new": "0.0.91",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "tsc --noEmit && node --test src/*.test.ts"
  },
  "keywords": [
    "hook",
    "react",
    "reducer",
    "redux-starter-kit",
    "useReducer",
    "immer",
    "redux"
  ]
}
